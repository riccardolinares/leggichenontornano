# Copia in .env. Serve solo alla pipeline: il sito e i test girano senza.
DATABASE_URL="postgresql://antinomia:antinomia@localhost:5432/antinomia"

# Dataset derivato da cui il sito e l'API leggono.
ANTINOMIA_SNAPSHOT="data/snapshot"

# Base pubblica del sito, per gli URL assoluti nei metadati social.
ANTINOMIA_SITE_URL="https://leleggichenontornano.it"
ANTINOMIA_REPO_URL="https://github.com/riccardolinares/leggichenontornano"

# Opzionale: estrattore deontico basato su modello linguistico. Senza queste
# credenziali il motore usa l'estrattore a regole e funziona lo stesso, con
# recall più basso e dichiarato.
# ANTHROPIC_API_KEY=""

# Opzionale: bot quotidiano. Senza credenziali il bot stampa cosa avrebbe
# pubblicato ed esce con successo.
# MASTODON_INSTANCE="https://mastodon.uno"
# MASTODON_TOKEN=""
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHANNEL="@leleggichenontornano"
